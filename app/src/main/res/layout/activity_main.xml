<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/engineNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.08"
                android:text="@string/title_zipformer"
                android:textColor="@color/accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/status_background"
                android:text="@string/model_loading"
                android:textColor="@color/success_text"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/title"
            android:textColor="@color/primary_text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/subtitle_zipformer"
            android:textColor="@color/secondary_text"
            android:textSize="14sp" />

        <GridLayout
            android:id="@+id/modelSelector"
            android:layout_width="match_parent"
            android:layout_height="108dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/model_selector_background"
            android:columnCount="3"
            android:padding="4dp"
            android:rowCount="2">

            <RadioButton
                android:id="@+id/zipformerOption"
                style="@style/ModelOption"
                android:checked="true"
                android:text="@string/label_zipformer" />

            <RadioButton
                android:id="@+id/onlineParaformerOption"
                style="@style/ModelOption"
                android:text="@string/label_online_paraformer" />

            <RadioButton
                android:id="@+id/offlineParaformerOption"
                style="@style/ModelOption"
                android:text="@string/label_offline_paraformer" />

            <RadioButton
                android:id="@+id/senseVoiceOption"
                style="@style/ModelOption"
                android:text="@string/label_sensevoice" />

            <RadioButton
                android:id="@+id/smartOption"
                style="@style/ModelOption"
                android:text="@string/label_smart" />

            <RadioButton
                android:id="@+id/vadOption"
                style="@style/ModelOption"
                android:text="@string/label_vad" />
        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1"
            android:background="@drawable/result_card_background"
            android:elevation="2dp"
            android:minHeight="200dp"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/result_label"
                    android:textColor="@color/secondary_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Chronometer
                    android:id="@+id/recordingTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/transcriptScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="16dp"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls">

                <TextView
                    android:id="@+id/transcriptText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="7dp"
                    android:text="@string/transcript_placeholder"
                    android:textColor="@color/primary_text"
                    android:textIsSelectable="true"
                    android:textSize="23sp" />
            </ScrollView>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:text="@string/hold_hint"
            android:textColor="@color/secondary_text"
            android:textSize="13sp" />

        <com.example.localvoice.HoldToTalkButton
            android:id="@+id/recordButton"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/record_button_background"
            android:enabled="false"
            android:stateListAnimator="@null"
            android:text="@string/hold_to_talk"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/privacy"
            android:textColor="@color/secondary_text"
            android:textSize="12sp" />

    </LinearLayout>
</FrameLayout>
